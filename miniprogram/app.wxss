page{background:#f7f7f1;color:#163a36;font-family:system-ui,-apple-system,'PingFang SC',sans-serif;font-size:28rpx}
button{border-radius:18rpx;font-size:28rpx;font-weight:600;background:#176a59;color:#fff;margin:18rpx 0;line-height:2.8}
button::after{border:0} button[disabled]{background:#d8dfd7;color:#6d7c72}
input,textarea{box-sizing:border-box;width:100%;padding:22rpx;border:1rpx solid #ccd8d0;background:#fff;border-radius:16rpx;font-size:28rpx}
textarea{height:160rpx} .secondary{background:#e9eee7;color:#235147}.danger{color:#9d4937}.muted{color:#61766c;font-size:24rpx;line-height:1.6}
.student-screen{padding:32rpx 28rpx 70rpx}.screen-title{font-size:44rpx;font-weight:700;margin:24rpx 0 14rpx}.screen-intro{color:#506d5e;line-height:1.8;margin-bottom:24rpx}.screen-notice{background:#ede8d6;color:#695c36;padding:18rpx;border-radius:14rpx;font-size:23rpx;line-height:1.7}.student-card{background:white;border:1rpx solid #dce4da;border-radius:22rpx;padding:26rpx;margin:24rpx 0;line-height:1.8}.student-card-title{font-size:31rpx;font-weight:650;margin-bottom:18rpx}.student-label{font-size:25rpx;color:#506c59;margin:18rpx 0 12rpx}.student-error{padding:18rpx;background:#fff0e8;color:#963d2b;border:1rpx solid #d8a791;border-radius:12rpx;line-height:1.7;margin-top:18rpx}.student-picker{padding:18rpx;background:#eff4e9;border-radius:12rpx;line-height:1.8}.student-feedback{padding:20rpx;background:#eff5e9;color:#355e43;border-radius:12rpx;line-height:1.9;margin:18rpx 0}.student-empty{padding:28rpx 0;color:#6a7e6c;line-height:1.9}.student-preline{white-space:pre-wrap;display:block;line-height:1.9}
