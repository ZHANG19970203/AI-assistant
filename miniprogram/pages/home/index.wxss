.page{padding:40rpx 30rpx 70rpx}.eyebrow{letter-spacing:3rpx;font-size:18rpx;color:#69806e;margin-top:24rpx}.hero-title{font-size:54rpx;font-weight:700;letter-spacing:-2rpx;margin:24rpx 0 12rpx}.subtitle{font-size:29rpx;color:#4f6e60;line-height:1.7}.notice{background:#ede8d6;color:#695c36;border-radius:12rpx;padding:18rpx;font-size:23rpx;margin:26rpx 0}.error{padding:22rpx;color:#963d2b;border:1rpx solid #d8a791;border-radius:14rpx;background:#fff0e8;line-height:1.7}.section-head{font-size:36rpx;font-weight:650;margin:46rpx 0 16rpx}.card{background:#fff;border:1rpx solid #dce4da;border-radius:24rpx;padding:28rpx;margin:22rpx 0;box-shadow:0 5rpx 20rpx #244d3b06}.card-title{font-weight:650;font-size:31rpx;line-height:1.6;margin:14rpx 0}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.badge{font-size:22rpx;color:#346849;background:#edf3e7;padding:5rpx 15rpx;border-radius:20rpx}.body{font-size:28rpx;color:#446054;line-height:1.8;margin:12rpx 0}.label{font-size:25rpx;color:#516c5b;line-height:1.7;margin:20rpx 0 12rpx}.picker{padding:20rpx;background:#f0f5ec;border-radius:12rpx;font-size:26rpx}.completion{border-color:#8ab59b}.answer{display:block;white-space:pre-wrap;line-height:1.9;font-size:28rpx}.citation{margin-top:20rpx;padding:20rpx;border-left:4rpx solid #8ead71;background:#f3f6ee;font-size:25rpx;line-height:1.8}.citation .label{margin-top:0;font-weight:600}.followup{padding-top:20rpx;color:#28654b;line-height:1.9}.footer{font-size:22rpx;line-height:1.8;color:#7b8b7e;margin-top:40rpx}
