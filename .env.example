# 本地原型可以离线运行；如配置大模型，真实密钥只放 .env.local，绝不放前端代码。
PORT=4317
# 仅限 127.0.0.1；本地演示不提供生产身份认证。
# DATABASE_PATH=data/companion.sqlite
# 可选：硅基流动 DeepSeek；模型名以硅基流动模型广场当前列表为准。
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# 可选：QQ邮箱SMTP。先在QQ邮箱设置中开启SMTP并生成授权码；不要填QQ登录密码。
QQ_MAIL_USER=
QQ_MAIL_APP_PASSWORD=
QQ_MAIL_HOST=smtp.qq.com
QQ_MAIL_PORT=465
# 已部署时再填写学生可访问的课程入口；本机localhost地址不能放进学生邮件。
PUBLIC_BASE_URL=

# 学生录音转写模型（可选，复用硅基流动服务端密钥）
SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
